from abc import abstractmethod
from typing import final, Self
class Base:
    def method(self) -> int: return 1
    def fluent(self) -> Self: return self
class Child(Base):
    def method(self)[ -> int]: return 2
    def fluent(self): return self
    def unannotated_base(self)[ -> Literal[3] | Unknown]: return 3
    @final
    def final_method(self)[ -> Literal[4]]: return 4
    @abstractmethod
    def abstract(self): ...
@final
class Final:
    def method(self)[ -> Literal[5]]: return 5
    def fluent(self)[ -> Self@fluent]: return self
    @classmethod
    def create(cls)[ -> Self@create]: return cls()

