def literal()[ -> Literal[1]]: return 1
def annotated() -> int: return 1
def implicit_none()[ -> None]: pass
def explicit_none()[ -> None]: return
def never()[ -> Never]: raise RuntimeError
def union(flag: bool)[ -> Literal[1, "a"]]:
    if flag:
        return 1
    return "a"
def outer()[ -> Literal[2]]:
    def inner()[ -> Literal[2]]: return 2
    return inner()
def multiline(
    x: int,
)[ -> int]: return x
def unknown(x): return x
def recursive(n: int)[ -> Literal[0]]:
    if n <= 0:
        return 0
    return recursive(n - 1)
def identity[T](x: T)[ -> T@identity]: return x
from typing import TypeVar
T = TypeVar("T")
def legacy_identity(x: T)[ -> T@legacy_identity]: return x

