     1,
     2,
 ]
 a[
-    # comment inside paren
     1,
-    2,
+    2,  # comment after 2
 ]
-a[1, 2]  # comment after 2
 a[
     # comment before 1-tuple paren
     1,  # comment after 1-tuple
```

