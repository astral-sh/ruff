I001 [*] Import block is un-sorted or un-formatted
  --> trailing_comma_as_imports.py:2:1
   |
 1 |   # A single aliased member is not split, so the trailing comma is respected.
 2 | / from glob import (
 3 | |     glob as g,
 4 | | )
 5 | |
 6 | | # A statement without aliases is not split, so the trailing comma is respected.
 7 | | from sys import (
 8 | |     argv,
 9 | |     stderr,
10 | | )
11 | |
12 | | # Split into one statement per aliased member, so the trailing comma is ignored.
13 | | from aws_cdk import (
14 | |     NestedStack,
15 | |     aws_ecr as ecr,
16 | |     aws_ecs as ecs,
17 | |     aws_events as events,
18 | |     aws_events_targets as targets,
19 | |     aws_iam as iam,
20 | |     aws_logs as logs,
21 | | )
   | |_^
