{
  "version": 2,
  "repositories": {
    "ruff": {
      "name": "astral-sh/ruff",
      "id": 523043277
    }
  },
  "rules": [
    {
      "repository": "ruff",
      "on": {
        "pull_request": ["opened", "reopened", "ready_for_review"]
      },
      "allow_forks": true,
      "workflow": "pull-request-reviewers.yml"
    },
    {
      "repository": "ruff",
      "on": {
        "pull_request": ["opened"]
      },
      "allow_draft": true,
      "allow_forks": true,
      "allow_stale_head": true,
      "workflow": "pull-request-labels-and-title.yml"
    },
    {
      "repository": "ruff",
      "on": {
        "workflow_run": ["completed"]
      },
      "conditions": {
        "/workflow/path": {
          "one_of": [
            ".github/workflows/ty-ecosystem-analyzer.yaml",
            ".github/workflows/typing_conformance.yaml",
            ".github/workflows/memory_report.yaml"
          ]
        },
        "/workflow_run/event": "pull_request",
        "/workflow_run/head_repository/fork": true,
        "/workflow_run/conclusion": { "one_of": ["success", "failure"] }
      },
      "workflow": "publish-pull-request-report.yml",
      "inputs": {
        "run_id": "/workflow_run/id",
        "run_attempt": "/workflow_run/run_attempt",
        "head_repository_id": "/workflow_run/head_repository/id"
      }
    },
    {
      "repository": "ruff",
      "on": {
        "pull_request": ["labeled"]
      },
      "conditions": {
        "/label/name": {
          "one_of": ["bot:ai-policy-comment", "bot:ai-policy-close"]
        }
      },
      "allow_draft": true,
      "allow_forks": true,
      "allow_stale_head": true,
      "workflow": "ai-policy.yml",
      "inputs": {
        "label": "/label/name"
      }
    },
    {
      "repository": "ruff",
      "on": {
        "issues": ["labeled"]
      },
      "conditions": {
        "/label/name": {
          "one_of": ["bot:ai-policy-comment", "bot:ai-policy-close"]
        },
        "/issue/state": "open"
      },
      "workflow": "ai-policy.yml",
      "inputs": {
        "issue": "/issue/number",
        "label": "/label/name"
      }
    }
  ]
}
